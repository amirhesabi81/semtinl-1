# SENTINEL 8.30.0 Railway release-candidate configuration
# Copy to .env only for local development. On Railway, add these as Variables.

# Required Telegram identity
BOT_TOKEN=
PRIMARY_ADMIN_ID=
ADMIN_IDS=
PUBLIC_CHANNEL_ID=
PRIVATE_CHANNEL_ID=
STAGING_PUBLIC_CHANNEL_ID=
STAGING_PRIVATE_CHANNEL_ID=
BOT_USERNAME=
SUPPORT_USERNAME=

# Branding
SIGNAL_BRAND_NAME=SENTINEL
SIGNAL_BRAND_HANDLE=SENTINEL
SENTINEL_TENANT_ID=default

# Unified HTTP server: Mini App, API, health, metrics and Telegram webhook
WEBAPP_URL=
WEBAPP_API_ENABLED=true
WEBAPP_AUTH_MAX_AGE_SECONDS=86400
WEBAPP_SESSION_TTL_SECONDS=86400
WEBAPP_SESSION_SECRET=
WEBAPP_SESSION_KEY_VERSION=v1
WEBAPP_SESSION_PREVIOUS_KEYS=
HEALTH_HOST=0.0.0.0
# Leave empty on Railway so the platform-injected PORT is used.
HEALTH_PORT=
METRICS_TOKEN=
TRUSTED_PROXY_IPS=127.0.0.1
HTTP_STARTUP_TIMEOUT_SECONDS=15
SESSION_BOOTSTRAP_TRANSPORT_COOLDOWN_SECONDS=0.2
SESSION_BOOTSTRAP_COOLDOWN_SECONDS=1.5

# Telegram delivery mode
# polling: one replica only
# webhook: Telegram posts to WEBHOOK_URL/WEBHOOK_PATH through the same FastAPI PORT
RUN_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=telegram
WEBHOOK_SECRET_TOKEN=
WEBHOOK_MAX_CONNECTIONS=40
WEBHOOK_QUEUE_MAXSIZE=1000
WEBHOOK_QUEUE_BATCH_SIZE=50
TELEGRAM_UPDATE_MAX_ATTEMPTS=5
TELEGRAM_UPDATE_RETENTION_DAYS=7
TELEGRAM_UPDATE_BACKLOG_READY_LIMIT=5000
TELEGRAM_UPDATE_DEAD_READY_LIMIT=50
TELEGRAM_UPDATE_MAX_READY_AGE_SECONDS=300
# Deprecated compatibility fields; no second listener is created.
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443

# Durable storage
DB_FILE=data/sentinel.sqlite3
DATABASE_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
REQUIRE_MIGRATION_BACKUP_REFERENCE=true
MIGRATION_BACKUP_REFERENCE=
MIGRATION_BACKUP_SHA256=
MIGRATION_BACKUP_CREATED_AT=
MIGRATION_BACKUP_DATABASE_FINGERPRINT=
MIGRATION_BACKUP_MAX_AGE_HOURS=24
MIGRATION_BACKUP_VERIFY_REMOTE=true
MIGRATION_BACKUP_REQUIRE_REMOTE_CHECKSUM=false
MIGRATION_BACKUP_VERIFY_TIMEOUT_SECONDS=15
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
PERSISTENCE_FILE=data/telegram-state.sqlite3
PERSISTENT_DATA_DIR=
RECEIPT_STORAGE_DIR=
# Persistent Volume path for Mini App ticket attachments.
SUPPORT_ATTACHMENT_STORAGE_DIR=
RECEIPT_ORPHAN_RETENTION_DAYS=7
RECEIPT_MIN_FREE_BYTES=268435456
RECEIPT_UPLOAD_COOLDOWN_SECONDS=5
RECEIPT_MAX_UPLOADS_PER_HOUR=10
RECEIPT_MAX_BYTES_PER_USER_PER_HOUR=26214400
RECEIPT_MAX_AVAILABLE_BYTES_PER_USER=15728640
RECEIPT_MAX_AVAILABLE_PER_USER=3
BACKUP_DIR=data/backups
LOG_DIR=logs
METRICS_FILE=data/metrics.json
HEARTBEAT_FILE=data/heartbeat.json
EXTERNAL_BACKUP_URL=

# Mandatory production encryption. Generate with: python scripts/generate_secrets.py
BACKUP_ENCRYPTION_KEY=
SENSITIVE_DATA_KEY=
BACKUP_KEY_VERSION=v1
BACKUP_PREVIOUS_KEYS=

# Railway production safety gates
REQUIRE_REDIS_FOR_PRODUCTION=true
ALLOW_LOCAL_RATE_LIMIT=false
REQUIRE_PERSISTENT_STORAGE=true
REQUIRE_PERSISTENT_RECEIPTS=true
ALLOW_EPHEMERAL_STORAGE=false
SENTINEL_REPLICA_COUNT=1
SENTINEL_ALLOWED_STORAGE_ROOTS=/app/data:/app/logs:/mnt/data:/data:/var/lib/sentinel
REDIS_URL=
REDIS_MAX_CONNECTIONS=30
REDIS_STREAM_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=1.5
REDIS_STREAM_SOCKET_TIMEOUT_SECONDS=16

# Optional S3/R2 receipt storage instead of a volume
RECEIPT_S3_BUCKET=
RECEIPT_S3_ENDPOINT=
RECEIPT_S3_REGION=auto
RECEIPT_S3_ACCESS_KEY_ID=
RECEIPT_S3_SECRET_ACCESS_KEY=
RECEIPT_S3_PREFIX=sentinel/receipts
RECEIPT_S3_SERVER_SIDE_ENCRYPTION=AES256
RECEIPT_S3_KMS_KEY_ID=
RECEIPT_S3_CONNECT_TIMEOUT_SECONDS=3
RECEIPT_S3_READ_TIMEOUT_SECONDS=10
RECEIPT_S3_MAX_ATTEMPTS=3

# FastAPI/SSE concurrency and blocking provider controls
BLOCKING_IO_MAX_CONCURRENCY=16
BLOCKING_IO_TIMEOUT_SECONDS=20
SSE_MAX_CONNECTIONS_PER_USER=3
SSE_MAX_CONNECTIONS_PER_SESSION=2
SSE_CONNECTION_TTL_SECONDS=90
SSE_ROTATE_SECONDS=55

# Runtime and scheduling
BOT_TIMEZONE=Asia/Tehran
CONCURRENT_UPDATES=8
IMAGE_RENDER_CONCURRENCY=2
VIP_CHECK_INTERVAL_SECONDS=900
CONTEST_CHECK_INTERVAL_SECONDS=300
ORDER_NOTIFICATION_INTERVAL_SECONDS=300
SIGNAL_TRACKING_INTERVAL_SECONDS=60
BROADCAST_BATCH_SIZE=25
BROADCAST_JOB_INTERVAL_SECONDS=15
HEARTBEAT_INTERVAL_SECONDS=30
HEARTBEAT_MAX_AGE_SECONDS=120
DEFAULT_CONTEST_DURATION_MINUTES=1440
REQUEST_TIMEOUT_SECONDS=10
REFERRAL_BATCH_SIZE=5
REFERRAL_BATCH_POINTS=2
PRIVACY_RETENTION_DAYS=365
PRIVACY_DELETE_GRACE_DAYS=7

# Manual payments (Rial and USDT both require an image receipt and admin approval)
USDT_QUOTE_VALID_MINUTES=30
USDT_VERIFICATION_ENABLED=false
VIP_APPROVAL_LEASE_SECONDS=300
TRONGRID_API_KEY=
TRON_API_URL=https://apilist.tronscanapi.com
ETHEREUM_RPC_URL=
BSC_RPC_URL=

# Optional market providers
BRS_API_KEY=
COINGECKO_DEMO_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=
EIA_API_KEY=
SEC_USER_AGENT=
SEC_TRACKED_COMPANIES=AAPL:0000320193,MSFT:0000789019,NVDA:0001045810,JPM:0000019617,XOM:0000034088

# Optional read-only broker bridge
BROKER_READONLY_BASE_URL=
BROKER_READONLY_API_KEY=
BROKER_READONLY_SECRET=

# Operational retention and release identity
STRUCTURED_LOGGING=true
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
EVENT_RETENTION_DAYS=180
ADMIN_COMMAND_RETENTION_DAYS=365
REDIS_CIRCUIT_OPEN_SECONDS=10
RELEASE_BUILD_NUMBER=
RELEASE_COMMIT_SHA=
RELEASE_IMAGE_DIGEST=

# Optional telemetry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional Telegram custom emoji IDs
UI_EMOJI_VIP_ID=
UI_EMOJI_EDUCATION_ID=
UI_EMOJI_MARKET_ID=
UI_EMOJI_RISK_ID=
UI_EMOJI_CONTEST_ID=
UI_EMOJI_SIGNAL_ID=
UI_EMOJI_ACCOUNT_ID=
UI_EMOJI_NEWS_ID=
UI_EMOJI_SUPPORT_ID=
UI_EMOJI_REWARDS_ID=

# Explicit staging attestation only; never point these to production.
TEST_DATABASE_URL=
TEST_REDIS_URL=
TEST_BOT_TOKEN=
TEST_PUBLIC_CHANNEL_ID=
TEST_PRIVATE_CHANNEL_ID=

# Read-only MetaTrader 5 connector (no paid API required)
MT5_CONNECTOR_ENABLED=true
MT5_PAIRING_TTL_MINUTES=15
MT5_CONNECTOR_SYNC_SECONDS=5
MT5_CONNECTOR_MAX_PAYLOAD_BYTES=1500000
# Optional Windows MT5 chart bridge; exact broker symbols, primary admin only.
MT5_MARKET_FEED_ENABLED=false
MT5_MARKET_FEED_CONNECTOR_ID=
MT5_MARKET_SYMBOLS_JSON={}
MT5_MARKET_PREFERRED_SYMBOLS=
# Opt in only after exact broker prices and history have been verified.
# Generates complete private paper plans; never enables broker order submission.
MT5_STRATEGY_PAPER_PLANS_ENABLED=false
KEYLESS_MARKET_SOURCES_ENABLED=true
# After a successful feed test, select mt5 using MARKET_GOLD_PROVIDER and/or MARKET_FX_PROVIDER.

# Google Gemini — server-side only. Never expose the key in Mini App JavaScript.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEMINI_USER_ASSISTANT_ENABLED=true
GEMINI_ADMIN_COPILOT_ENABLED=true
GEMINI_CRM_ENABLED=true
GEMINI_CHANNEL_CONTROL_ENABLED=true
GEMINI_USER_BEHAVIOR_ENABLED=true
GEMINI_TICKET_ASSISTANT_ENABLED=true
GEMINI_SIGNAL_ANALYSIS_ENABLED=true
GEMINI_RISK_SUPERVISION_ENABLED=true
GEMINI_SYSTEM_MONITORING_ENABLED=true
GEMINI_USER_DAILY_REQUEST_LIMIT=5
GEMINI_ADMIN_DAILY_REQUEST_LIMIT=50
GEMINI_DAILY_TOKEN_LIMIT=1000000
GEMINI_MONTHLY_TOKEN_LIMIT=20000000
GEMINI_DATA_RETENTION_DAYS=90
GEMINI_CONTEXT_MAX_CHARS=60000
GEMINI_PSEUDONYM_KEY=
GEMINI_CONTEXT_CACHE_SECONDS=300
GEMINI_AUTONOMOUS_PRIMARY_ADMIN=true
GEMINI_PRIMARY_ADMIN_FULL_BOT_ACCESS=false
GEMINI_SAFETY_THRESHOLD=BLOCK_MEDIUM_AND_ABOVE
GEMINI_DELEGATED_ADMIN_APPROVAL_REQUIRED=true
GEMINI_MAX_TOOL_CALLS_PER_REQUEST=20
GEMINI_HEALTHCHECK_TTL_SECONDS=300
GEMINI_USER_REVIEW_CACHE_SECONDS=600
GEMINI_DAILY_REPORT_ENABLED=false
GEMINI_DAILY_REPORT_HOUR=8
# The numeric primary admin may use all registered Sentinel application tools.
# Infrastructure primitives (raw shell/SQL/secrets/deploy) are not model tools.

# Admin Command OS
GEMINI_CONFIRM_SENSITIVE_ACTIONS=true
GEMINI_VOICE_COMMANDS_ENABLED=true
GEMINI_VOICE_MODEL=gemini-3.5-flash
GEMINI_VOICE_MAX_SECONDS=120
GEMINI_VOICE_MAX_BYTES=10485760
GEMINI_IMAGE_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-lite-image
GEMINI_GENERATED_ADS_DIR=/data/generated_ads

# Required in production before enabling webhook automation; comma-separated trusted hosts.
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=

# Keep 0 in production to retain only a SHA-256 prompt fingerprint.
AI_AD_PROMPT_PREVIEW_CHARS=0
AI_AD_ASSET_RETENTION_DAYS=30
AI_AD_ASSET_MAX_TOTAL_BYTES=2147483648

# ---------------------------------------------------------------------------
# Google Sheets secondary database / disaster-recovery mirror
# Target workbook: Sentinel secondary database
# ---------------------------------------------------------------------------
GOOGLE_SHEETS_BACKUP_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=
# Paste the complete Google Cloud service-account JSON as ONE Railway variable.
# Never commit a real private key into this file/repository.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Alternative to the plain JSON variable above (base64-encoded JSON). Use one only.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_SHEETS_WRITE_FAILOVER=true
GOOGLE_SHEETS_AUTO_RECONCILE=true
GOOGLE_SHEETS_PROJECTION_ENABLED=true
# false mirrors business tables separately and excludes high-rate market data.
# This business-only backup is not a complete normalized database restore image.
GOOGLE_SHEETS_NORMALIZED_BACKUP_ENABLED=false
GOOGLE_SHEETS_TIMEOUT_SECONDS=8
GOOGLE_SHEETS_MAX_RETRIES=3

# Runtime self-healing. The watchdog is independent of asyncio and forces a
# non-zero exit only after repeated evidence that the event loop/health server
# is stuck, allowing Railway ON_FAILURE restart policy to recover the service.
# Production durability guard. Keep true on Railway; disable only for disposable staging.
REQUIRE_PERSISTENT_BACKUPS=true
# Keep false unless a coordinated multi-replica Google write lease/CAS is explicitly deployed.
ALLOW_MULTI_REPLICA_GOOGLE_WRITE_FAILOVER=false
# Bounded sync-I/O worker admission. Timed-out threads keep their permit until they really stop.
BLOCKING_IO_MAX_CONCURRENCY=16
BLOCKING_IO_TIMEOUT_SECONDS=20
BLOCKING_IO_ACQUIRE_TIMEOUT_SECONDS=3
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_LOCK_TIMEOUT_MS=5000
POSTGRES_POOL_ACQUIRE_TIMEOUT_SECONDS=5
POSTGRES_LEGACY_POOL_MAX=10
POSTGRES_PERSISTENCE_POOL_MAX=6

RUNTIME_WATCHDOG_ENABLED=true
RUNTIME_WATCHDOG_INTERVAL_SECONDS=15
RUNTIME_WATCHDOG_STARTUP_GRACE_SECONDS=180
RUNTIME_WATCHDOG_HEARTBEAT_MAX_AGE_SECONDS=180
RUNTIME_WATCHDOG_FAILURE_LIMIT=3

# Railway preDeploy transient-connectivity retry policy.
PREDEPLOY_MAX_ATTEMPTS=5
PREDEPLOY_RETRY_BASE_SECONDS=1
TELEGRAM_METADATA_TIMEOUT_SECONDS=8
GOOGLE_SHEETS_RECONCILE_INTERVAL_SECONDS=60

# Bounded Telegram recovery and idle wizard expiration
TELEGRAM_BOOTSTRAP_ATTEMPTS=6
TELEGRAM_BOOTSTRAP_TIMEOUT_SECONDS=30
TELEGRAM_PUMP_RESTART_ATTEMPTS=5
BOT_SESSION_TIMEOUT_SECONDS=1800

# Independent progress watchdog (idle bots are healthy).
RUNTIME_WATCHDOG_DELIVERY_STALL_SECONDS=180

# Hard limit for globally saturated blocking IO (independent watchdog).
BLOCKING_IO_WATCHDOG_MAX_AGE_SECONDS=240

# Operator-owned broker binding; user ID -> local account ID -> external reference.
# Private bridge must validate X-Telegram-User-ID and X-Owner-Signature.
BROKER_READONLY_ACCOUNT_BINDINGS={}

# SENTINEL 9 candidate market foundation (server-side only)
MARKET_CHART_POLL_SECONDS=60
MARKET_INDEX_PROVIDER=yahoo
MARKET_FX_PROVIDER=yahoo_fx
# Free anonymous candles; no signup, token or payment required by this adapter.
MARKET_GOLD_PROVIDER=biquote
MARKET_GOLD_REFERENCE_PROVIDERS=gold_api,goldpricetoday_ir
# Optional Iranian candle service. Requires your own provider-issued token.
STREAMDATA_API_TOKEN=
STREAMDATA_SYMBOLS_JSON={"XAUUSD":"FX_XAUUSD"}
STREAMDATA_MINUTE_BUDGET=20
STREAMDATA_DAILY_BUDGET=2000
# Conservative shared caps. Gold retains credits when FX fallback is busy.
TWELVE_DATA_MINUTE_BUDGET=7
TWELVE_DATA_DAILY_BUDGET=720
TWELVE_DATA_NON_GOLD_DAILY_BUDGET=360
MARKET_INDEX_SYMBOLS_JSON={"US30":"DJI","US100":"NDX"}
DB_POOL_MAX_WAITING=64
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_POOL_MAX_IDLE_SECONDS=300
DB_POOL_RECONNECT_TIMEOUT_SECONDS=30
DB_LOCK_TIMEOUT_MS=5000

# Read-only keyless live chart pulse (event-prioritized RESEARCH, never execution)
# Public OKX ticker WebSocket + existing biquote quote monitor
SENTINEL_LIVE_CHART_WATCH=true
# No API Key is needed for the two public WebSocket sources.
# Does not change the existing MARKET_*_PROVIDER, or indices safety pause.

# Service child recovery; platform draining window must exceed shutdown budget.
SERVICE_RESTART_BASE_SECONDS=2
SERVICE_RESTART_MAX_SECONDS=60
SERVICE_STABLE_RESET_SECONDS=300
SERVICE_STARTUP_TIMEOUT_SECONDS=240
SERVICE_SHUTDOWN_TIMEOUT_SECONDS=45
SERVICE_HTTP_STALL_SECONDS=180
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0

# Explicitly scan the selected broker USD crypto CFDs instead of exchange USDT pairs.
MT5_CRYPTO_SCAN_ONLY=false

# Rewards C50: direct Mini App link from BotFather, same bot as BOT_USERNAME.
# No secret. Leave empty to use bot-only publication buttons.
REWARDS_MINIAPP_LINK=
REWARDS_PLATFORM_ENABLED=true

# C51 durable inbox: normal/important retention in days (bounded 7..3650).
# Order transition notices retain 365 days; no payment ledger is deleted.
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_IMPORTANT_DAYS=365
